# rd-harness CORE local secrets template
# Copy to ~/.dev-automation/.env (chmod 600) — NEVER commit real keys to git!
# Channel adapter credentials (e.g. Telegram) live separately under ~/.dev-automation/adapters/*.env.

# Central Orchestrator (Anthropic HTTP API — default model: claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Optional: custom Anthropic API base URL (leave blank for https://api.anthropic.com)
# ANTHROPIC_BASE_URL=

# Optional: Bearer token to protect the external HTTP/SSE protocol server
# RD_PROTOCOL_TOKEN=
